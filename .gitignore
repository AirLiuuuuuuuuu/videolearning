# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and test artifacts
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment and editor files
.env
.env.*
!.env.example
.vscode/*.log

# Local video data and generated processing results
data/raw/*
!data/raw/.gitkeep
data/interim/*
